APP_NAME="Livraison"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=livraison
DB_USERNAME=livraison
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Durée de vie des jetons d'API en minutes (30 jours)
SANCTUM_EXPIRATION=43200

# Temps réel (Laravel Reverb) : générer les clés avec `php artisan reverb:install`
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# WhatsApp (API Cloud de Meta) : « auto » = envois réels pour chaque entreprise dont le numéro est
# connecté (Paramètres > WhatsApp, vérifié auprès de Meta), simulation pour les autres ;
# « log » = simulation partout (développement) ; « meta » = réel dès qu'un numéro est renseigné.
WHATSAPP_DRIVER=auto
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_ID=
WHATSAPP_SIGNUP_CONFIG_ID=
# Utilisateur système de Jibiat (jeton permanent) : relais du jeton de 60 jours du bouton
WHATSAPP_SYSTEM_USER_ID=
WHATSAPP_SYSTEM_USER_TOKEN=

# Facultatif : Claude comprend les commandes WhatsApp écrites librement.
# Sans clé, l'analyse se fait par règles (formats « Nom : … / Tél : … » et messages simples).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# API publique : requêtes par minute et par clé
PUBLIC_API_RATE_LIMIT=120

# Webhooks sortants : laisser à false en production (HTTPS seulement, jamais vers un réseau privé)
WEBHOOKS_ALLOW_HTTP=false
WEBHOOKS_ALLOW_PRIVATE_TARGETS=false

# Notifications push des livreurs (Web Push) : générer avec « php artisan webpush:vapid »
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@livraison.test

# SMS de repli quand WhatsApp échoue : log | twilio | none
SMS_DRIVER=log
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Entreprise affichée sur les pages publiques (slug ou identifiant ; par défaut la première active)
# Sans effet sur la plateforme multi-entreprises (PLATFORM_DOMAIN) : l'adresse désigne l'entreprise
BRANDING_COMPANY=

# Plateforme multi-entreprises : chaque entreprise sur {slug}.PLATFORM_DOMAIN, la console sur
# admin.PLATFORM_DOMAIN, la présentation sur PLATFORM_DOMAIN. Vide = une seule entreprise.
PLATFORM_DOMAIN=
# Préproduction : code d'accès demandé avant toute page (ignoré en production)
PREPROD_ACCESS_CODE=
# Indexation par les moteurs de recherche (défaut : en production seulement)
# SEARCH_INDEXING=
PLATFORM_ADMIN_SUBDOMAIN=admin
PLATFORM_SCHEME=https
# Requêtes par minute dans l'espace connecté, par compte et par entreprise
PLATFORM_USER_RATE_LIMIT=300
PLATFORM_COMPANY_RATE_LIMIT=3000
# Essai gratuit des nouvelles entreprises créées avec une formule (jours ; 0 = aucun)
PLATFORM_TRIAL_DAYS=30
# Factures mensuelles : préfixe des numéros, échéance, puis alerte et restriction (jours après l'échéance)
PLATFORM_INVOICE_PREFIX=FAC
PLATFORM_INVOICE_DUE_DAYS=10
PLATFORM_BILLING_WARNING_DAYS=7
PLATFORM_BILLING_RESTRICT_DAYS=15
# Éditeur de la plateforme : page /confidentialite (exigée par Meta) et demandes de suppression
PLATFORM_OPERATOR=Jibiat
MARKETING_WHATSAPP_NUMBER=+2250507016739
# Éditeur (conditions générales, pied de page du site)
LEGAL_NAME="Jibiat SARL"
LEGAL_ADDRESS="Abidjan, Côte d'Ivoire"
LEGAL_EMAIL=contact@jibiat.com
LEGAL_RCCM=
PLATFORM_CONTACT_EMAIL=
PLATFORM_CONTACT_PHONE=

# Domaines personnalisés des entreprises (docs/PLATEFORME.md, « Domaines personnalisés ») :
# nom vers lequel les clients font pointer leur domaine (CNAME), et création automatique du
# nom d'hôte chez Cloudflare for SaaS (jeton « SSL and Certificates : Edit », zone de PLATFORM_DOMAIN)
PLATFORM_CUSTOM_DOMAIN_TARGET=
PLATFORM_SERVER_IP=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Mandataires de confiance : « cloudflare » derrière le proxy Cloudflare (adresse IP réelle des
# visiteurs), sinon une liste d'adresses séparées par des virgules ; vide = aucun
TRUSTED_PROXIES=
