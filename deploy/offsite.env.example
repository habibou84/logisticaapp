# Copie des sauvegardes hors du serveur (deploy/backup.sh), avec rclone dans un conteneur Docker.
#
#   cp deploy/offsite.env.example .env.offsite && chmod 600 .env.offsite   # puis remplir ci-dessous
#   bash deploy/backup.sh --verifier                                       # vérifie ce fichier et la connexion
#   bash deploy/backup.sh                                                  # essai : doit afficher « copiée hors du serveur »
#
# Format : NOM=valeur, sans guillemets (fichier lu par « docker run --env-file »). Ne jamais le committer.
#
# Exemple : Cloudflare R2 (10 Go gratuits par mois). Tableau de bord Cloudflare › R2 › Create bucket (juridiction EU),
# puis Manage R2 API Tokens › Create API Token : « Object Read & Write », limité à ce bucket.

RCLONE_CONFIG_STOCKAGE_TYPE=s3
RCLONE_CONFIG_STOCKAGE_PROVIDER=Cloudflare
RCLONE_CONFIG_STOCKAGE_ACCESS_KEY_ID=access-key-id
RCLONE_CONFIG_STOCKAGE_SECRET_ACCESS_KEY=secret-access-key
# Adresse « S3 API » affichée par Cloudflare (bucket › Settings), SANS la fin « /nom-du-bucket ».
# Le plus souvent https://<Account ID>.r2.cloudflarestorage.com ; avec « .eu. » seulement si le bucket a été créé avec
# la juridiction « European Union » (un emplacement « Western Europe (WEUR) » n'en est pas une).
RCLONE_CONFIG_STOCKAGE_ENDPOINT=https://identifiant-du-compte.r2.cloudflarestorage.com
RCLONE_CONFIG_STOCKAGE_REGION=auto
# Clé limitée à un bucket : rclone ne doit pas essayer de vérifier ou de créer le bucket (refusé par R2)
RCLONE_CONFIG_STOCKAGE_NO_CHECK_BUCKET=true

# Chiffrement (fortement recommandé : la base contient noms, téléphones et adresses). Les fichiers sont chiffrés
# sur le serveur avant l'envoi ; le stockage ne voit que des données illisibles.
# Mot de passe à « masquer » une fois, puis à coller ci-dessous :
#   docker run --rm rclone/rclone:1.68.2 obscure 'une-longue-phrase-secrete'
# Gardez la phrase d'origine dans un gestionnaire de mots de passe : sans elle, les sauvegardes sont perdues.
RCLONE_CONFIG_CHIFFRE_TYPE=crypt
RCLONE_CONFIG_CHIFFRE_REMOTE=stockage:nom-du-bucket/logistica
RCLONE_CONFIG_CHIFFRE_PASSWORD=resultat-de-rclone-obscure

# Destination : « chiffre: » (chiffré, recommandé) ou « stockage:nom-du-bucket/logistica » (en clair)
OFFSITE_DEST=chiffre:

# Base : rotation. Une sauvegarde par jour gardée 14 jours (jour/), celle du dimanche gardée 12 semaines (semaine/),
# celle du 1er du mois gardée 12 mois (mois/) : environ 38 copies pour un an d'historique. 0 : ne jamais effacer.
OFFSITE_KEEP_DAILY=14
OFFSITE_KEEP_WEEKLY=12
OFFSITE_KEEP_MONTHLY=12

# Fichiers (photos de preuve, pièces d'identité, documents, logos) : miroir dans fichiers/actuel, seuls les nouveaux
# sont envoyés chaque nuit. Un fichier supprimé ou remplacé sur le serveur est gardé N jours dans fichiers/supprimes.
OFFSITE_FILES=1
OFFSITE_FILES_KEEP_DELETED=30
# Garde-fou : au-delà de ce nombre de suppressions en une nuit, la copie s'arrête en erreur (volume vidé par erreur ?)
OFFSITE_FILES_MAX_DELETE=500
# Durée maximale de la copie des fichiers (la première envoie tout) ; au-delà, elle s'arrête en erreur
OFFSITE_FILES_TIMEOUT=6h

# Autres fournisseurs : remplacer les lignes STOCKAGE ci-dessus par
#   Backblaze B2 (régler aussi le bucket sur « Keep only the last version of the file ») :
#     RCLONE_CONFIG_STOCKAGE_TYPE=b2
#     RCLONE_CONFIG_STOCKAGE_ACCOUNT=keyID
#     RCLONE_CONFIG_STOCKAGE_KEY=applicationKey
#   Amazon S3 :
#     RCLONE_CONFIG_STOCKAGE_TYPE=s3
#     RCLONE_CONFIG_STOCKAGE_PROVIDER=AWS
#     RCLONE_CONFIG_STOCKAGE_ACCESS_KEY_ID=…
#     RCLONE_CONFIG_STOCKAGE_SECRET_ACCESS_KEY=…
#     RCLONE_CONFIG_STOCKAGE_REGION=eu-west-3
